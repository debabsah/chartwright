{
  "spec_version": "1",
  "dashboard": {
    "title": "NYC Yellow Taxi Operations",
    "slug": "nyc-taxi-operations"
  },
  "charts": [
    {
      "name": "Total Trips",
      "type": "big_number_total",
      "dataset": {
        "database": "examples",
        "schema": "main",
        "table": "nyc_yellow_taxi"
      },
      "metric": "COUNT(*)",
      "subtitle": "completed trips",
      "number_format": ",.0f"
    },
    {
      "name": "Total Revenue",
      "type": "big_number_total",
      "dataset": {
        "database": "examples",
        "schema": "main",
        "table": "nyc_yellow_taxi"
      },
      "metric": "SUM(total_amount)",
      "subtitle": "all charges, USD",
      "number_format": "$,.0f"
    },
    {
      "name": "Average Fare",
      "type": "big_number_total",
      "dataset": {
        "database": "examples",
        "schema": "main",
        "table": "nyc_yellow_taxi"
      },
      "metric": "AVG(fare_amount)",
      "subtitle": "per trip, USD",
      "number_format": "$,.2f"
    },
    {
      "name": "Average Trip Distance",
      "type": "big_number_total",
      "dataset": {
        "database": "examples",
        "schema": "main",
        "table": "nyc_yellow_taxi"
      },
      "metric": "AVG(trip_distance)",
      "subtitle": "miles",
      "number_format": ",.2f"
    },
    {
      "name": "Daily Trips",
      "type": "timeseries_line",
      "dataset": {
        "database": "examples",
        "schema": "main",
        "table": "nyc_yellow_taxi"
      },
      "metrics": [
        "COUNT(*) AS Trips"
      ],
      "time_column": "pickup_time",
      "time_grain": "P1D"
    },
    {
      "name": "Daily Revenue",
      "type": "timeseries_area",
      "dataset": {
        "database": "examples",
        "schema": "main",
        "table": "nyc_yellow_taxi"
      },
      "metrics": [
        "SUM(total_amount) AS Revenue"
      ],
      "time_column": "pickup_time",
      "time_grain": "P1D"
    },
    {
      "name": "Demand by Hour and Weekday",
      "type": "heatmap",
      "dataset": {
        "database": "examples",
        "schema": "main",
        "table": "nyc_yellow_taxi"
      },
      "x_column": "pickup_hour",
      "y_column": "pickup_weekday",
      "metric": "COUNT(*)"
    },
    {
      "name": "How Riders Pay",
      "type": "pie",
      "dataset": {
        "database": "examples",
        "schema": "main",
        "table": "nyc_yellow_taxi"
      },
      "metric": "COUNT(*)",
      "groupby": "payment_method",
      "donut": true,
      "row_limit": 7
    },
    {
      "name": "Trips by Pickup Borough",
      "type": "bar",
      "dataset": {
        "database": "examples",
        "schema": "main",
        "table": "nyc_yellow_taxi"
      },
      "x_column": "pickup_borough",
      "metrics": [
        "COUNT(*) AS Trips"
      ],
      "row_limit": 8
    },
    {
      "name": "Top 10 Pickup Zones",
      "type": "bar",
      "dataset": {
        "database": "examples",
        "schema": "main",
        "table": "nyc_yellow_taxi"
      },
      "x_column": "pickup_zone",
      "metrics": [
        "COUNT(*) AS Trips"
      ],
      "orientation": "horizontal",
      "row_limit": 10
    },
    {
      "name": "Trip Distance Distribution (trips up to 20 mi)",
      "type": "histogram",
      "dataset": {
        "database": "examples",
        "schema": "main",
        "table": "nyc_yellow_taxi"
      },
      "column": "trip_distance",
      "bins": 25,
      "filters": [
        {
          "column": "trip_distance",
          "op": "<=",
          "value": 20
        }
      ]
    }
  ],
  "filters": [
    {
      "type": "time_range",
      "name": "Date"
    },
    {
      "type": "select",
      "name": "Pickup Borough",
      "dataset": {
        "database": "examples",
        "schema": "main",
        "table": "nyc_yellow_taxi"
      },
      "column": "pickup_borough"
    },
    {
      "type": "select",
      "name": "Payment Method",
      "dataset": {
        "database": "examples",
        "schema": "main",
        "table": "nyc_yellow_taxi"
      },
      "column": "payment_method"
    }
  ],
  "layout": {
    "sketch": [
      "AAA BBB CCC DDD",
      "AAA BBB CCC DDD",
      "EEEEEE FFFFFF",
      "EEEEEE FFFFFF",
      "EEEEEE FFFFFF",
      "EEEEEE FFFFFF",
      "GGGGGGG HHHHH",
      "GGGGGGG HHHHH",
      "GGGGGGG HHHHH",
      "GGGGGGG HHHHH",
      "GGGGGGG HHHHH",
      "IIIII JJJJJJJ",
      "IIIII JJJJJJJ",
      "IIIII JJJJJJJ",
      "IIIII JJJJJJJ",
      "IIIII JJJJJJJ",
      "KKKKKKKKKKKK",
      "KKKKKKKKKKKK",
      "KKKKKKKKKKKK",
      "KKKKKKKKKKKK"
    ],
    "legend": {
      "A": "Total Trips",
      "B": "Total Revenue",
      "C": "Average Fare",
      "D": "Average Trip Distance",
      "E": "Daily Trips",
      "F": "Daily Revenue",
      "G": "Demand by Hour and Weekday",
      "H": "How Riders Pay",
      "I": "Trips by Pickup Borough",
      "J": "Top 10 Pickup Zones",
      "K": "Trip Distance Distribution (trips up to 20 mi)"
    }
  }
}
