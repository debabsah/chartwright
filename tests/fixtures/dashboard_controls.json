{
  "spec_version": "1",
  "dashboard": {
    "title": "Airline Operations",
    "slug": "airline-operations",
    "color_scheme": "supersetColors",
    "description": "On-time performance and delay causes, refreshed hourly.",
    "certified_by": "Data Platform",
    "certification_details": "Reconciled with the finance close",
    "published": false,
    "refresh_frequency": 300,
    "filter_bar_orientation": "horizontal"
  },
  "charts": [
    {"name": "Flights", "type": "big_number_total", "metric": "COUNT(*)",
     "description": "Scheduled departures, including cancelled ones.",
     "dataset": {"database": "warehouse", "table": "flights"}},
    {"name": "On-Time Rate", "type": "timeseries_line", "time_column": "flight_date",
     "metrics": ["SQL(100.0 * SUM(on_time) / NULLIF(COUNT(*), 0)) AS On-time %"],
     "time_grain": "P1M", "color_scheme": "bnbColors",
     "annotations": [
       {"name": "Goal", "value": 80, "style": "dashed", "color": "#1A7F37", "width": 2},
       {"name": "Trend", "formula": "0.001*x + 60", "style": "dotted", "opacity": "medium"}
     ],
     "display_name": "On-time %",
     "certified_by": "Ops Analytics", "certification_details": "Matches the DOT definition",
     "cache_timeout": 3600,
     "dataset": {"database": "warehouse", "table": "flights"}},
    {"name": "Delays by Cause", "type": "bar", "x_column": "delay_cause",
     "metrics": ["SUM(delay_minutes) AS Minutes"], "color_scheme": "googleCategory10c",
     "annotations": [{"name": "Budget", "value": 5000}],
     "filters": [{"sql": "delay_minutes > 0 OR cancelled = 1"}],
     "dataset": {"database": "warehouse", "table": "flights"}},
    {"name": "Delays over Time", "type": "timeseries_bar", "time_column": "flight_date",
     "metrics": ["SUM(delay_minutes)"], "color_scheme": "echarts5Colors",
     "dataset": {"database": "warehouse", "table": "flights"}},
    {"name": "Load Factor", "type": "timeseries_area", "time_column": "flight_date",
     "metrics": ["AVG(load_factor)"], "color_scheme": "d3Category10",
     "annotations": [{"name": "Break-even", "value": 0.72}],
     "dataset": {"database": "warehouse", "table": "flights"}},
    {"name": "Distance vs Delay", "type": "timeseries_scatter", "time_column": "flight_date",
     "metrics": ["AVG(delay_minutes)"], "color_scheme": "lyftColors",
     "dataset": {"database": "warehouse", "table": "flights"}},
    {"name": "Carrier Share", "type": "pie", "metric": "COUNT(*)", "groupby": "carrier",
     "color_scheme": "presetColors",
     "dataset": {"database": "warehouse", "table": "flights"}},
    {"name": "Delay Distribution", "type": "histogram", "column": "delay_minutes",
     "color_scheme": "colorsOfRainbow",
     "dataset": {"database": "warehouse", "table": "flights"}},
    {"name": "Booking Funnel", "type": "funnel", "metric": "COUNT(*)", "groupby": "stage",
     "color_scheme": "blueToGreen",
     "dataset": {"database": "warehouse", "table": "flights"}},
    {"name": "Routes", "type": "treemap", "metric": "COUNT(*)", "groupby": ["origin", "dest"],
     "color_scheme": "wavesOfBlue",
     "dataset": {"database": "warehouse", "table": "flights"}},
    {"name": "Flights and Delay", "type": "mixed", "x_column": "flight_date", "time_grain": "P1M",
     "a": {"metrics": ["COUNT(*)"], "kind": "bar"},
     "b": {"metrics": ["AVG(delay_minutes)"], "kind": "line", "axis": "secondary"},
     "color_scheme": "modernSunset",
     "annotations": [{"name": "Target delay", "value": 15, "style": "dashed"}],
     "dataset": {"database": "warehouse", "table": "flights"}}
  ],
  "filters": [
    {"type": "select", "name": "Region", "column": "region",
     "dataset": {"database": "warehouse", "table": "flights"},
     "description": "The departure airport's region",
     "pre_filter": [{"column": "active", "value": true}],
     "time_range": "Last year", "time_column": "flight_date",
     "sort_metric": "flight_count", "sort_descending": true},
    {"type": "select", "name": "City", "column": "origin_city",
     "dataset": {"database": "warehouse", "table": "flights"},
     "dependencies": ["Region"], "search_all_options": true},
    {"type": "select", "name": "Exclude Carrier", "column": "carrier",
     "dataset": {"database": "warehouse", "table": "flights"},
     "inverse_selection": true, "charts": ["Carrier Share", "Delays by Cause"]},
    {"type": "range", "name": "Delay", "column": "delay_minutes",
     "dataset": {"database": "warehouse", "table": "flights"},
     "dependencies": ["Region"], "pre_filter": [{"sql": "delay_minutes >= 0"}]},
    {"type": "time_range", "name": "Period", "default": "Last quarter",
     "charts": ["On-Time Rate", "Delays over Time"]},
    {"type": "time_grain", "name": "Grain", "default": "P1W",
     "dataset": {"database": "warehouse", "table": "flights"},
     "charts": ["On-Time Rate", "Delays over Time", "Load Factor"]},
    {"type": "time_column", "name": "Date Basis", "default": "flight_date",
     "dataset": {"database": "warehouse", "table": "flights"}, "required": true}
  ],
  "layout": {
    "tabs": [
      {"title": "Overview", "rows": [
        {"header": "Performance", "size": "large", "background": "white"},
        {"row": ["Flights", "On-Time Rate"], "background": "white"},
        {"divider": true},
        ["Delays by Cause", "Delays over Time"],
        {"header": "Capacity", "size": "small"},
        ["Load Factor", "Distance vs Delay"]
      ]},
      {"title": "Mix", "rows": [
        ["Carrier Share", "Delay Distribution"],
        ["Booking Funnel", "Routes"],
        ["Flights and Delay"]
      ]}
    ],
    "footer": [
      {"divider": true},
      [{"markdown": "Source: DOT on-time data", "height": 1}]
    ]
  }
}
