{
  "spec_version": "1",
  "dashboard": {"title": "Display Controls", "slug": "cw-live-display-controls"},
  "charts": [
    {
      "name": "Revenue KPI",
      "type": "big_number_trend",
      "dataset": {"database": "examples", "table": "cleaned_sales_data"},
      "metric": "SUM(sales)",
      "time_column": "order_date",
      "time_grain": "P1M",
      "time_range": "Last year",
      "compare_lag": 1,
      "compare_suffix": "vs last month",
      "subtitle": "Booked revenue",
      "trend_color": "#0057B8"
    },
    {
      "name": "Trailing Revenue",
      "type": "big_number_trend",
      "dataset": {"database": "examples", "table": "cleaned_sales_data"},
      "metric": "SUM(sales)",
      "time_column": "order_date",
      "time_grain": "P1M",
      "rolling_type": "sum",
      "rolling_periods": 12,
      "rolling_min_periods": 6,
      "compare_lag": 12,
      "subtitle": "Trailing 12 months",
      "y_axis_truncate": true
    },
    {
      "name": "Orders This Quarter",
      "type": "big_number_total",
      "dataset": {"database": "examples", "table": "cleaned_sales_data"},
      "metric": "SQL(COUNT(*)) AS Orders",
      "number_format": "SMART_NUMBER",
      "time_range": "Last quarter",
      "height": 3.4
    },
    {
      "name": "Latest Order",
      "type": "big_number_total",
      "dataset": {"database": "examples", "table": "cleaned_sales_data"},
      "metric": "MAX(order_date)",
      "date_format": "%a %-d %b %Y",
      "subtitle": "Data through"
    },
    {
      "name": "Sales by Line",
      "type": "timeseries_line",
      "dataset": {"database": "examples", "table": "cleaned_sales_data"},
      "metrics": ["SUM(sales)"],
      "time_column": "order_date",
      "time_grain": "P1M",
      "groupby": "product_line",
      "series_limit": 5,
      "series_limit_metric": "SQL(SUM(quantity_ordered)) AS Units",
      "series_limit_ascending": true,
      "height": 4.6,
      "show_value": true,
      "stack": "stream",
      "only_total": false,
      "contribution": "row",
      "markers": true,
      "marker_size": 4,
      "area": true,
      "opacity": 0.5,
      "x_axis_title": "Month",
      "y_axis_title": "Revenue (USD)",
      "y_axis_min": 0,
      "y_axis_max": 1,
      "y_axis_truncate": true,
      "show_legend": true,
      "legend_position": "bottom",
      "legend_type": "plain",
      "x_label_rotation": 45
    },
    {
      "name": "Monthly Orders",
      "type": "timeseries_bar",
      "dataset": {"database": "examples", "table": "cleaned_sales_data"},
      "metrics": ["COUNT(*)"],
      "time_column": "order_date",
      "time_grain": "P1M",
      "groupby": "deal_size",
      "stack": true,
      "show_value": true,
      "y_axis_log": true,
      "y_axis_min": 1
    },
    {
      "name": "Quantity Area",
      "type": "timeseries_area",
      "dataset": {"database": "examples", "table": "cleaned_sales_data"},
      "metrics": ["SUM(quantity_ordered)"],
      "time_column": "order_date",
      "time_grain": "P1M",
      "groupby": "deal_size",
      "stack": "expand",
      "markers": true,
      "marker_size": 3,
      "opacity": 0.7,
      "show_legend": false
    },
    {
      "name": "Price vs Time",
      "type": "timeseries_scatter",
      "dataset": {"database": "examples", "table": "cleaned_sales_data"},
      "metrics": ["AVG(price_each)"],
      "time_column": "order_date",
      "marker_size": 10,
      "y_axis_max": 200
    },
    {
      "name": "Orders by Hour",
      "type": "bar",
      "dataset": {"database": "examples", "table": "cleaned_sales_data"},
      "x_column": "quarter",
      "metrics": ["COUNT(*)"],
      "groupby": "deal_size",
      "category_sort": "asc",
      "x_label_every": true,
      "stack": true,
      "contribution": "series",
      "series_limit": 3,
      "legend_position": "right",
      "time_range": "Last year"
    },
    {
      "name": "Countries by Deal Size",
      "type": "bar",
      "dataset": {"database": "examples", "table": "cleaned_sales_data"},
      "x_column": "country",
      "metrics": ["SUM(sales)"],
      "groupby": "deal_size",
      "orientation": "horizontal",
      "stack": true,
      "sort_by": "total"
    },
    {
      "name": "Lines by Quantity",
      "type": "bar",
      "dataset": {"database": "examples", "table": "cleaned_sales_data"},
      "x_column": "product_line",
      "metrics": ["SUM(sales)"],
      "orientation": "horizontal",
      "sort_by": "SUM(quantity_ordered)",
      "annotations": [{"name": "Target", "value": 1000000, "style": "dashed", "color": "#B3261E"}]
    },
    {
      "name": "Share by Line",
      "type": "pie",
      "dataset": {"database": "examples", "table": "cleaned_sales_data"},
      "metric": "SUM(sales)",
      "groupby": "product_line",
      "donut": true,
      "label_type": "value_percent",
      "number_format": ",.0f",
      "show_total": true,
      "labels_outside": false,
      "legend_position": "left",
      "legend_type": "plain",
      "row_limit": 7
    },
    {
      "name": "Order Funnel",
      "type": "funnel",
      "dataset": {"database": "examples", "table": "cleaned_sales_data"},
      "metric": "COUNT(*)",
      "groupby": "status",
      "label_type": "key_value_percent",
      "number_format": ",d",
      "legend_position": "bottom"
    },
    {
      "name": "Sales Treemap",
      "type": "treemap",
      "dataset": {"database": "examples", "table": "cleaned_sales_data"},
      "metric": "SUM(sales)",
      "groupby": ["product_line"],
      "label_type": "value",
      "number_format": "$,.0f"
    },
    {
      "name": "Top Customers",
      "type": "table",
      "dataset": {"database": "examples", "table": "cleaned_sales_data"},
      "metrics": ["SUM(sales)"],
      "groupby": ["customer_name"],
      "row_limit": 50,
      "sort_by": "SQL(MAX(sales)) AS Largest order",
      "height": 9.6,
      "page_length": 20,
      "show_totals": true,
      "search_box": true,
      "number_formats": {"SUM(sales)": "$,.0f"},
      "column_align": {"customer_name": "left", "SUM(sales)": "right"},
      "column_widths": {"customer_name": 220},
      "column_headers": {"SUM(sales)": "Revenue", "customer_name": "Customer"}
    },
    {
      "name": "Sales Pivot",
      "type": "pivot_table",
      "dataset": {"database": "examples", "table": "cleaned_sales_data"},
      "rows": ["country", "deal_size"],
      "columns": ["year"],
      "metrics": ["SUM(sales)", "COUNT(*)"],
      "aggregate_function": "Average",
      "row_order": "value_desc",
      "column_order": "z_to_a",
      "row_subtotals": true,
      "transpose": true,
      "metrics_layout": "rows",
      "row_limit": 500
    },
    {
      "name": "Line by Deal Size",
      "type": "heatmap",
      "dataset": {"database": "examples", "table": "cleaned_sales_data"},
      "x_column": "product_line",
      "y_column": "deal_size",
      "metric": "SUM(sales)",
      "show_values": true,
      "color_scheme": "schemeBlues",
      "number_format": ",.0f",
      "show_percentage": false,
      "normalize_across": "y",
      "show_legend": false,
      "x_order": "value_desc",
      "y_order": "a_to_z",
      "x_label_every": 2,
      "y_label_every": 1,
      "left_margin": 16
    },
    {
      "name": "Price Spread",
      "type": "histogram",
      "dataset": {"database": "examples", "table": "cleaned_sales_data"},
      "column": "price_each",
      "x_axis_title": "Unit price",
      "y_axis_title": "Orders"
    },
    {
      "name": "Revenue and Orders",
      "type": "mixed",
      "dataset": {"database": "examples", "table": "cleaned_sales_data"},
      "x_column": "order_date",
      "time_grain": "P1M",
      "time_range": "Last year",
      "a": {"metrics": ["SQL(SUM(sales)) AS Revenue"], "groupby": "deal_size", "show_value": true,
            "stack": true, "only_total": false, "series_limit": 2,
            "series_limit_metric": "SQL(COUNT(*)) AS Orders", "series_limit_ascending": true},
      "b": {"metrics": ["SQL(count(*)) AS Orders"], "kind": "line",
            "axis": "secondary", "groupby": "status", "show_value": true, "series_limit": 3},
      "height": 5.8,
      "x_axis_title": "Month",
      "y_axis_title": "Revenue",
      "y_axis_title_secondary": "Orders",
      "y_axis_min": 0,
      "y_axis_max_secondary": 500,
      "y_axis_log_secondary": true,
      "y_axis_truncate": true,
      "legend_position": "bottom"
    },
    {
      "name": "Sales and Price Areas",
      "type": "mixed",
      "dataset": {"database": "examples", "table": "cleaned_sales_data"},
      "x_column": "order_date",
      "time_grain": "P1M",
      "a": {"metrics": ["SUM(sales)"], "kind": "area", "opacity": 1},
      "b": {"metrics": ["AVG(price_each)"], "kind": "area", "axis": "secondary", "opacity": 0.4}
    },
    {
      "name": "Yearly Sales Steps",
      "type": "waterfall",
      "dataset": {"database": "examples", "table": "cleaned_sales_data"},
      "x_column": "order_date",
      "time_grain": "P1Y",
      "groupby": "deal_size",
      "metric": "SUM(sales)",
      "total_label": "All years",
      "increase_color": "green",
      "decrease_color": "red",
      "total_color": "#5B6770",
      "increase_label": "Gain",
      "decrease_label": "Loss",
      "show_value": true,
      "show_legend": true,
      "number_format": ",.0f",
      "x_axis_title": "Year",
      "y_axis_title": "Sales",
      "x_label_format": "%Y",
      "x_label_rotation": 0
    },
    {
      "name": "Daily Sales Spread",
      "type": "box_plot",
      "dataset": {"database": "examples", "table": "cleaned_sales_data"},
      "metrics": ["SUM(sales)"],
      "distribute_across": ["order_date"],
      "time_grain": "P1D",
      "groupby": ["deal_size"],
      "whiskers": [5, 95],
      "number_format": "$,.0f",
      "x_axis_title": "Deal size",
      "y_axis_title": "Daily sales",
      "x_label_rotation": 45,
      "row_limit": 5000,
      "color_scheme": "wavesOfBlue"
    },
    {
      "name": "Order Value Range",
      "type": "box_plot",
      "dataset": {"database": "examples", "table": "cleaned_sales_data"},
      "metrics": ["SUM(sales)"],
      "distribute_across": ["order_number"],
      "groupby": ["product_line"],
      "whiskers": "min_max"
    }
  ],
  "layout": {
    "rows": [
      ["Revenue KPI", "Trailing Revenue", "Orders This Quarter", "Latest Order"],
      ["Sales by Line", "Monthly Orders"],
      ["Quantity Area", "Price vs Time"],
      ["Orders by Hour", "Share by Line"],
      ["Countries by Deal Size", "Lines by Quantity"],
      ["Order Funnel", "Sales Treemap"],
      ["Top Customers"],
      ["Sales Pivot"],
      ["Line by Deal Size", "Price Spread"],
      ["Revenue and Orders"],
      ["Sales and Price Areas"],
      ["Yearly Sales Steps"],
      ["Daily Sales Spread", "Order Value Range"]
    ]
  }
}
